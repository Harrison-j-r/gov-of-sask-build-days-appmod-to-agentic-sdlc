  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/core.test.mjs tests/improvements.test.mjs tests/distribution.test.mjs",
